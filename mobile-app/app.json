{
  "expo": {
    "name": "mobile-app",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ycom.eduvo.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c3ab4a2e-d8c5-4a97-9e28-2cd4f9333ac3"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Eduvo to access your photos to submit homework.",
          "cameraPermission": "Allow Eduvo to use the camera to take homework photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Eduvo to use the camera to capture homework photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D4ED8",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Eduvo"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "eduvo-mobile",
          "organization": "eduvo",
          "disableAutoUpload": true
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/c3ab4a2e-d8c5-4a97-9e28-2cd4f9333ac3",
      "enabled": false,
      "checkAutomatically": "NEVER"
    }
  }
}
